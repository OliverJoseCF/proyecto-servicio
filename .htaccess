# Proteger archivos sensibles del repositorio accesibles desde la raíz del proyecto.
# Si el docroot apunta a esta carpeta (y no a plataforma/), estos archivos
# no deben ser descargables desde el navegador.
<FilesMatch "\.(sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
