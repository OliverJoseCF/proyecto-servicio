Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /plataforma/

    # Redirigir directamente a archivos/carpetas existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Bloquear acceso a archivos sensibles
    RewriteRule ^shared/config\.local\.php$ - [F,L]
    RewriteRule ^shared/config\.php$ - [F,L]
</IfModule>

# Bloquear listado de directorios sensibles
<FilesMatch "\.(sql|log|sh|bak|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
